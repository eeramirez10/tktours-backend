# Copy this file to your local secret store or environment setup.
# Do not commit real secrets.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tktours_concierge_v2?schema=public"
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Generate with: openssl rand -base64 48
ADMIN_JWT_SECRET=
ADMIN_AUTH_TOKEN_TTL=8h
RESOURCES_STORAGE_DIR=./storage/resources
PUBLIC_BASE_URL=https://gnomologic-zita-unarduously.ngrok-free.dev

# OpenAI
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6-luna.
# OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=30000

# Meta WhatsApp Cloud API. Use Meta's test phone-number ID in development.
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_GRAPH_API_VERSION=
