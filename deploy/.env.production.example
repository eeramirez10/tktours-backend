# Docker Compose interpolation and runtime configuration. Copy to .env on the Ubuntu server.
HOST_PORT=4001

NODE_ENV=production
PORT=4001
LOG_LEVEL=info
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tktours_concierge_v2?schema=public"

# Public HTTPS URL where Meta can retrieve resource downloads and call webhooks.
PUBLIC_BASE_URL=https://api.example.com
CORS_ORIGIN=https://admin.example.com
RESOURCES_STORAGE_DIR=/app/storage/resources

# Generate with: openssl rand -base64 48
ADMIN_JWT_SECRET=
ADMIN_AUTH_TOKEN_TTL=8h

OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6-luna.
# OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=30000

# Meta WhatsApp Cloud API. Use the production phone-number ID in this file.
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_GRAPH_API_VERSION=
