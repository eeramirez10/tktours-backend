# Docker Compose interpolation and runtime configuration. Copy to .env on the Ubuntu server.
HOST_PORT=4001
RESOURCES_HOST_DIR=/srv/tktours/resources

NODE_ENV=production
PORT=4001
LOG_LEVEL=info
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/tktours_concierge_v2?schema=public"

# Public HTTPS URL where Twilio can retrieve resource downloads and call webhooks.
PUBLIC_BASE_URL=https://api.example.com
CORS_ORIGIN=https://admin.example.com
RESOURCES_STORAGE_DIR=/app/storage/resources

# Generate with: openssl rand -base64 48
ADMIN_JWT_SECRET=
ADMIN_AUTH_TOKEN_TTL=8h

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
